# Local development: leave empty to use Vite's /api proxy (also works on phones).
# Hosted frontend: set this to the HTTPS URL of the matching backend release.
VITE_API_URL=

# Server-only. Never prefix a secret with VITE_ — that inlines it into the browser bundle.
# JWT_SECRET is optional: otherwise a secure key is generated and stored next to DB_PATH.
JWT_SECRET=
# Optional: post a message to a Telegram chat on login/logout. Leave both empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Durable storage without a paid Render disk: free Upstash Redis (upstash.com), REST API.
# Set both to use it; leave both empty to fall back to the local DB_PATH JSON file.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
